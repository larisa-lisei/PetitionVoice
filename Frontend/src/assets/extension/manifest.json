{
  "manifest_version": 3,
  "name": "Petition of the Day",
  "version": "1.0.0",
  "action": {
    "default_title": "Petition of the Day",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": ["http://localhost:8079/*"]
}
